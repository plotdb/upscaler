doctype html
html
  head
    +css([
      {name: "bootstrap", path: "dist/css/bootstrap.min.css"},
      {name: "@loadingio/bootstrap.ext"}
    ])
    style(type="text/css"): include:stylus index.styl
  body
    .w-1024.rwd.mx-auto.my-5
      .btn.btn-outline-secondary.btn-upload #[span Upload]#[input(type="file",ld="upload")]
      .root(ld="root")
        .cell
          label Original Image
          div(ld="img1") Empty
        .cell
          label Upscaled Image
          div(ld="img2") Empty

    +script([
      {name: "proxise"},
      {name: "@loadingio/debounce.js"},
      {name: "@loadingio/ldquery"},
      {name: "ldview"},
      {name: "ldfile"},
      {name: "@plotdb/upscaler"},
      {name: "@tensorflow/tfjs", path: "dist/tf.min.js"},
      {name: "@tensorflow/tfjs-backend-webgpu", path: "dist/tf-backend-webgpu.min.js"}
    ])
    script(type="module"): include:lsc index.ls

